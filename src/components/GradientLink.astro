---
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a
  class="text-transparent bg-clip-text bg-gradient-to-r from-geraldine-500 to-carrot-orange-500 relative"
  href={href}
  target="_blank"
  referrerpolicy="no-referrer"
>
  <slot />
  <span
    class="absolute w-full h-1 bg-gradient-to-r from-geraldine-500 to-carrot-orange-500 -bottom-1 left-0"
  ></span></a
>
