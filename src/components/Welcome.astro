---
import Head from "./Head.astro";
---

<div class="border-8 border-load box-border welcome-h">
  <div class="w-full h-full rounded-lg flex relative bg-zinc-950">
    <div class="w-full m-auto z-10">
      <Head className="w-3/4 md:w-1/2 xl:w-1/3 m-auto" />
      <h1
        class="text-center text-zinc-100 m-auto text-lg sm:text-3xl 2xl:text-4xl 3xl:text-5xl p-2 italic appear"
      >
        Full-Stack Software Engineer
      </h1>
    </div>
    <div class="halo-bg fixed top-0 left-0 right-0 bottom-0 z-0"></div>
  </div>
</div>

<style>
  .welcome-h {
    height: 100svh;
  }

  @property --accent-colour {
    syntax: "<color>";
    initial-value: theme("colors.zinc.950");
    inherits: false;
  }

  .border-load {
    --accent-colour: theme("colors.zinc.950");
    background-color: var(--accent-colour);
    border-color: var(--accent-colour);
    animation: load-accent var(--load-half-time) ease-in-out
      var(--load-half-time) 1 forwards;
  }

  @keyframes load-accent {
    from {
      --accent-colour: theme("colors.zinc.950");
    }
    to {
      --accent-colour: theme("colors.geraldine.500");
    }
  }

  .halo-bg {
    background: theme("colors.zinc.950")
      radial-gradient(
        circle at center,
        var(--accent-colour),
        theme("colors.transparent") 50%
      );
    opacity: 0.15;

    animation: load-accent var(--load-time) ease-in-out var(--load-half-time) 1
      forwards;
  }

  .appear {
    opacity: 0;
    animation: appear var(--load-half-time) ease-in-out var(--load-half-time) 1
      forwards;
  }

  @keyframes appear {
    from {
      opacity: 0;
    }
    to {
      opacity: 0;
    }
  }
</style>
