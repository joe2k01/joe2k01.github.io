---
import Link from "./Link.astro";

interface Props {
  title: string;
  description: string;
  link: string;
}

const { title, description, link } = Astro.props;
---

<li class="w-full mb-10 md:mb-20 md:pb-2 border-b-2 border-b-zinc-50">
  <a class="w-full flex flex-col md:flex-row md:justify-between" href={link}>
    <div class="w-full md:w-8/12">
      <h3
        class="text-lg md:text-2xl lg:text-3xl xl:text-4xl 2xl:text-5xl 3xl:text-6xl text-zinc-50"
      >
        {title}
      </h3>
      <p
        class="py-2 md:text-lg lg:text-xl xl:text-2xl 2xl:text-3xl 3xl:text-4xl text-zinc-300 text-justify whitespace-normal"
      >
        <span>
          {description}
        </span>
        <Link link={link} />
      </p>
    </div>
    <div class="hidden md:block w-3/12 p-2 aspect-video bg-geraldine-500 rounded-lg">
      <slot />
    </div>
  </a>
</li>
