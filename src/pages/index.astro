---
import Layout from "../layouts/Layout.astro";
import "@fontsource-variable/josefin-sans";
import "@fontsource/lobster/latin-400.css";
import Head from "../components/Head.astro";
import Button from "../components/Button.astro";
import GitHub from "../components/GitHub.astro";
import Linkedin from "../components/Linkedin.astro";
import GMail from "../components/GMail.astro";
import Old from "../components/Old.astro";
import Welcome from "../components/Welcome.astro";
---

<Layout title="Giuseppe Barillari">
  <main class="bg-zinc-950">
    <Welcome />
  </main>
</Layout>

<style>
  .header {
    opacity: 0;
    animation: appear var(--load-half-time) ease-in-out var(--load-half-time) 1
      forwards;
  }

  @keyframes appear {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
