---
import Layout from "../layouts/Layout.astro";
import "@fontsource-variable/josefin-sans";
import "@fontsource/lobster/latin-400.css";
import Head from "../components/Head.astro";
import Button from "../components/Button.astro";
import GitHub from "../components/GitHub.astro";
import Linkedin from "../components/Linkedin.astro";
import GMail from "../components/GMail.astro";
import Old from "../components/Old.astro";
import Welcome from "../components/Welcome.astro";
import Slant from "../components/Slant.astro";
import Nav from "../components/Nav.astro";
import Projects from "../components/Projects.astro";
import Experience from "../components/Experience.astro";
---

<Layout title="Giuseppe Barillari">
  <main class="bg-geraldine-500">
    <Welcome />
    <Slant>
      <Nav />
      <Experience />
      <Projects />
    </Slant>
  </main>
</Layout>

<style>
  main {
    perspective: 100svh;
  }
</style>
